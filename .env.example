# ============================================================
# サミット特売OCR & LINE通知 設定ファイル
# cp .env.example .env  してから値を埋めてください
# ============================================================

# ─── Summit 店舗設定 ──────────────────────────────────────────
# 店舗IDの調べ方:
#   1. https://www.summitstore.co.jp/store/ を開く
#   2. 最寄り店舗をクリック
#   3. URLの ?id=XXX の数字が SUMMIT_STORE_ID
# 例: https://www.summitstore.co.jp/store/tokyo/post/?id=151
#     → 151 がミナノ分倍河原店のID
SUMMIT_STORE_ID=151

# ─── Summit WP API 認証情報 ───────────────────────────────────
# 公式サイトの読み取り専用アカウント（公開情報）
SUMMIT_WP_USER=preview
SUMMIT_WP_PASS=xxxx xxxx xxxx xxxx xxxx xxxx

# ─── Ollama / Gemma 4 設定 ───────────────────────────────────
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma4

# ─── LINE Messaging API ──────────────────────────────────────
# LINE Developers で取得
LINE_CHANNEL_ACCESS_TOKEN=your_channel_access_token_here
LINE_USER_ID=Uxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── オプション ───────────────────────────────────────────────
LOG_LEVEL=INFO
REQUEST_INTERVAL=1.0
